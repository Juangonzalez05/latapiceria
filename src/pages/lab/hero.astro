---
// Laboratorio de diseño: tres conceptos de hero navegables. Página interna, fuera de buscadores.
import Base from '../../layouts/Base.astro';
import HeroA from '../../components/lab/HeroA.astro';
import HeroB from '../../components/lab/HeroB.astro';
import HeroC from '../../components/lab/HeroC.astro';

const concepts = [
  { id: 'concepto-a', name: 'A · Editorial enmarcado', note: 'Fondo crema, titular en 3 líneas y foto vertical en arco. Recomendado.' },
  { id: 'concepto-b', name: 'B · Mosaico de oficio', note: 'Titular arriba y tira taller → tela → tapizado → en casa.' },
  { id: 'concepto-c', name: 'C · Inmersivo corregido', note: 'Foto a sangre con el sofá visible. Se ve blanda en pantallas 2x.' },
];
---

<Base title="Laboratorio · Conceptos de hero" description="Prototipos internos del hero de La Tapicería." noindex>
  <nav class="lab-index bg-negro text-crema on-dark" aria-label="Conceptos">
    <div class="container-x flex flex-col gap-3 py-5 md:flex-row md:items-center md:justify-between">
      <p class="font-serif text-lg">Laboratorio · Hero</p>
      <ul class="flex flex-wrap gap-2 text-sm">
        {concepts.map((c) => (
          <li><a href={`#${c.id}`} class="inline-flex min-h-11 items-center rounded-full border border-crema/30 px-4 hover:bg-crema hover:text-negro" title={c.note}>{c.name}</a></li>
        ))}
      </ul>
    </div>
  </nav>
  <main>
    <HeroA />
    <HeroB />
    <HeroC />
  </main>
</Base>
