---
// Barra de anuncio: solo existe si site.announcement tiene un mensaje real.
// En desarrollo, sin mensaje, aparece una sola línea con el TODO para recordarlo.
import site from '../data/site.json';
import Icon from './Icon.astro';
import { SHOW_TODOS } from '../lib/flags';

const message = site.announcement.trim();
const render = message || SHOW_TODOS;
---

{render && (
  <div id="anuncio" class="relative z-[60] bg-esmeralda text-crema on-dark" data-announcement>
    <div class="container-x flex min-h-10 items-center justify-center py-2 pr-12 text-center text-small">
      {message ? (
        <p class="truncate sm:whitespace-normal">{message}</p>
      ) : (
        <p class="truncate"><span class="todo">TODO · mensaje de cobertura, visita sin costo u oferta</span></p>
      )}
      <button
        type="button"
        class="absolute right-1 top-1/2 grid size-11 -translate-y-1/2 place-items-center rounded-full text-crema/80 transition-colors hover:bg-white/10 hover:text-crema"
        aria-label="Cerrar anuncio"
        data-announcement-close
      >
        <Icon name="close" size={16} />
      </button>
    </div>
  </div>
)}

<script>
  const bar = document.querySelector<HTMLElement>('[data-announcement]');
  const KEY = 'lt-anuncio-cerrado';
  try {
    if (sessionStorage.getItem(KEY)) bar?.remove();
  } catch {}
  bar?.querySelector('[data-announcement-close]')?.addEventListener('click', () => {
    bar.remove();
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {}
  });
</script>
