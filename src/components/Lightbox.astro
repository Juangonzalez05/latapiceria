---
import Icon from './Icon.astro';
---

<dialog class="lightbox on-dark m-0 h-full max-h-none w-full max-w-none overscroll-contain bg-negro/95 p-0 text-crema backdrop:bg-transparent" aria-label="Galería de proyectos" data-lightbox>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <p class="text-sm tracking-widest text-crema/70" data-lb-counter aria-live="polite"></p>
      <button type="button" class="lb-btn" aria-label="Cerrar galería" data-lb-close><Icon name="close" /></button>
    </div>

    <figure class="relative flex min-h-0 flex-1 flex-col items-center justify-center px-4 sm:px-20">
      <img class="lb-img max-h-full max-w-full object-contain" alt="" data-lb-img />
      <figcaption class="py-4 text-center">
        <span class="block font-serif text-xl" data-lb-title></span>
        <span class="text-xs uppercase tracking-[0.18em] text-crema/60" data-lb-cat></span>
      </figcaption>
      <button type="button" class="lb-btn absolute left-2 top-1/2 -translate-y-1/2 sm:left-6" aria-label="Foto anterior" data-lb-prev><Icon name="arrow-left" /></button>
      <button type="button" class="lb-btn absolute right-2 top-1/2 -translate-y-1/2 sm:right-6" aria-label="Foto siguiente" data-lb-next><Icon name="arrow" /></button>
    </figure>
  </div>
</dialog>

<style>
  .lightbox[open] {
    display: block;
    animation: lb-in 300ms var(--ease-suave) both;
  }
  @keyframes lb-in {
    from {
      opacity: 0;
    }
  }
  .lb-img {
    transition: opacity 250ms var(--ease-suave);
  }
  .lb-img.is-loading {
    opacity: 0;
  }
  .lb-btn {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: rgb(6 6 6 / 0.5);
    border: 1px solid rgb(234 234 229 / 0.3);
    transition: background-color 250ms;
  }
  .lb-btn:hover {
    background: rgb(234 234 229 / 0.15);
  }
</style>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dlg) {
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const title = dlg.querySelector<HTMLElement>('[data-lb-title]')!;
    const cat = dlg.querySelector<HTMLElement>('[data-lb-cat]')!;
    const counter = dlg.querySelector<HTMLElement>('[data-lb-counter]')!;
    let list: HTMLElement[] = [];
    let index = 0;
    let opener: HTMLElement | null = null;

    const visible = () =>
      [...document.querySelectorAll<HTMLElement>('[data-open-lightbox]')].filter((b) => !b.closest('[hidden]'));

    const show = (i: number) => {
      index = (i + list.length) % list.length;
      const b = list[index];
      img.classList.add('is-loading');
      img.onload = () => img.classList.remove('is-loading');
      img.src = b.dataset.full!;
      img.alt = b.dataset.alt ?? '';
      title.textContent = b.dataset.title ?? '';
      cat.textContent = b.dataset.cat ?? '';
      counter.textContent = `${index + 1} / ${list.length}`;
      // Precarga la siguiente
      const next = list[(index + 1) % list.length];
      if (next) new Image().src = next.dataset.full!;
    };

    document.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('[data-open-lightbox]');
      if (!b) return;
      list = visible();
      opener = b;
      show(list.indexOf(b));
      dlg.showModal();
      document.documentElement.style.overflow = 'hidden';
    });

    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(index - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(index + 1));
    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
    // Clic fuera de la imagen cierra
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg || (e.target as HTMLElement).tagName === 'FIGURE') dlg.close();
    });
    dlg.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      opener?.focus();
    });

    // Gesto de deslizar en táctil
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => (x0 = e.pointerType === 'touch' ? e.clientX : null));
    dlg.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
