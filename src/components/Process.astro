---
// Proceso compacto.
// Escritorio: foto fija (sticky) que cambia con el paso activo + lista de pasos unida por un hilo que se llena al bajar.
// Móvil: tarjetas deslizables (scroll-snap) con contador y flechas.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import SectionHeader from './ui/SectionHeader.astro';
import steps from '../data/steps.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="proceso" class="section-y bg-crema-50" aria-labelledby="proceso-titulo" data-process>
  <div class="container-x">
    <SectionHeader
      id="proceso-titulo"
      variant="center"
      title="Del brief a la entrega, sin prisas"
      lead="Seis pasos claros y un mismo equipo de principio a fin. Sabrás siempre en qué punto va cada pieza."
    />

    <div class="grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-12 lg:gap-12">
      <!-- Foto fija (solo escritorio) -->
      <div class="hidden lg:col-span-5 lg:block" aria-hidden="true">
        <div class="sticky top-28">
          <div class="frame relative aspect-[4/5] max-w-[28rem]">
            {steps.map((s, i) => (
              <Image
                src={photo(s.image)}
                alt=""
                widths={[448, 672, 896]}
                sizes="448px"
                class:list={['step-photo absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
                data-step-photo={i}
              />
            ))}
          </div>
        </div>
      </div>

      <!-- Pasos -->
      <div class="relative lg:col-span-7 lg:col-start-6 lg:pl-6">
        <div class="rail absolute bottom-12 left-12 top-12 hidden w-px lg:block" aria-hidden="true">
          <div class="rail-fill absolute inset-0 origin-top" data-rail-fill></div>
        </div>
        <ol class="steps no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:block lg:snap-none lg:overflow-visible lg:px-0" data-steps aria-label="Pasos del proceso">
          {steps.map((s, i) => (
            <li class="step relative w-[82%] shrink-0 snap-start rounded-card bg-crema p-4 sm:w-[60%] lg:grid lg:w-auto lg:grid-cols-[3rem_minmax(0,1fr)] lg:gap-6 lg:bg-transparent lg:p-0 lg:py-7" data-step={i}>
              <div class="frame mb-4 aspect-[4/3] lg:hidden">
                <Image src={photo(s.image)} alt={s.alt} widths={[320, 480, 640]} sizes="(min-width: 640px) 60vw, 82vw" class="h-full w-full object-cover" />
              </div>
              <span class="step-num relative z-10 hidden font-serif text-[1.35rem] leading-none lg:grid lg:size-12 lg:place-items-center lg:rounded-full" aria-hidden="true">{pad(i + 1)}</span>
              <div>
                <p class="label lg:hidden">Paso {i + 1} de {steps.length}</p>
                <h3 class="mt-1 text-h3 lg:mt-0">
                  <span class="sr-only">Paso {i + 1}: </span>{s.title}
                </h3>
                <p class="mt-2 max-w-[36rem] text-gris">{s.text}</p>
                {s.todo && <Todo text={s.todo} class="mt-3" />}
              </div>
            </li>
          ))}
        </ol>
        <div class="mt-4 flex items-center justify-between lg:hidden">
          <p class="text-small text-gris" aria-live="polite" data-step-count>Paso 1 de {steps.length}</p>
          <div class="flex gap-2">
            <button type="button" class="carousel-arrow" aria-label="Paso anterior" data-step-prev><Icon name="arrow-left" /></button>
            <button type="button" class="carousel-arrow" aria-label="Paso siguiente" data-step-next><Icon name="arrow" /></button>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-12 text-center lg:mt-16" data-reveal>
      <a href={waLink('Hola, queremos empezar un proyecto. ¿Les enviamos el brief?')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
        <Icon name="whatsapp" size={20} />
        Enviar el brief
        <Icon name="arrow" size={16} class="btn-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .step-photo {
    opacity: 0;
    transition: opacity 600ms var(--ease-suave);
  }
  .step-photo.is-active {
    opacity: 1;
  }
  /* Hilo: punteado de fondo, se llena en terra al avanzar */
  .rail {
    background-image: linear-gradient(to bottom, var(--color-sepia) 50%, transparent 50%);
    background-size: 1px 10px;
    opacity: 0.6;
  }
  .rail-fill {
    background: var(--color-terra);
    transform: scaleY(0);
  }
  @media (min-width: 1024px) {
    .step-num {
      color: var(--color-sepia-700);
      background: var(--color-crema-50);
      border: 1px solid rgb(155 118 75 / 0.45);
      transition:
        background-color 350ms var(--ease-suave),
        color 350ms var(--ease-suave),
        border-color 350ms var(--ease-suave);
    }
    .step.is-active .step-num {
      background: var(--color-terra-700);
      border-color: var(--color-terra-700);
      color: var(--color-crema);
    }
    .step h3,
    .step p {
      transition: color 350ms var(--ease-suave);
    }
    .step:not(.is-active) h3 {
      color: var(--color-gris);
    }
  }
  :global(.carousel-arrow) {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid rgb(6 6 6 / 0.25);
    transition:
      background-color 250ms,
      color 250ms,
      opacity 250ms;
  }
  :global(.carousel-arrow:hover:not([aria-disabled='true'])) {
    background: var(--color-negro);
    color: var(--color-crema);
  }
  :global(.on-dark .carousel-arrow) {
    border-color: rgb(234 234 229 / 0.35);
  }
  :global(.on-dark .carousel-arrow:hover:not([aria-disabled='true'])) {
    background: var(--color-crema);
    color: var(--color-negro);
  }
  :global(.carousel-arrow[aria-disabled='true']) {
    opacity: 0.35;
    cursor: default;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-process]');
  if (root) {
    const list = root.querySelector<HTMLElement>('[data-steps]')!;
    const items = [...list.querySelectorAll<HTMLElement>('[data-step]')];
    const photos = [...root.querySelectorAll<HTMLElement>('[data-step-photo]')];
    const fill = root.querySelector<HTMLElement>('[data-rail-fill]')!;
    const count = root.querySelector<HTMLElement>('[data-step-count]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-step-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-step-next]')!;
    const desktop = window.matchMedia('(min-width: 1024px)');

    const setActive = (n: number) => {
      items.forEach((it, i) => it.classList.toggle('is-active', i === n));
      photos.forEach((p, i) => p.classList.toggle('is-active', i === n));
    };

    // Escritorio: paso activo = el que cruza la mitad de la pantalla; el hilo se llena con el avance.
    let ticking = false;
    const onScroll = () => {
      if (ticking || !desktop.matches) return;
      ticking = true;
      requestAnimationFrame(() => {
        const mid = window.innerHeight * 0.5;
        let active = 0;
        items.forEach((it, i) => {
          if (it.getBoundingClientRect().top < mid) active = i;
        });
        setActive(active);
        const r = list.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
        fill.style.transform = `scaleY(${p.toFixed(3)})`;
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Móvil: contador y flechas sobre el carrusel.
    const index = () => {
      const w = items[0].getBoundingClientRect().width + 16;
      return Math.min(items.length - 1, Math.max(0, Math.round(list.scrollLeft / w)));
    };
    const syncMobile = () => {
      if (desktop.matches) return;
      const i = index();
      count.textContent = `Paso ${i + 1} de ${items.length}`;
      prev.setAttribute('aria-disabled', String(i === 0));
      next.setAttribute('aria-disabled', String(i === items.length - 1));
    };
    const go = (d: number) => {
      const i = Math.min(items.length - 1, Math.max(0, index() + d));
      list.scrollTo({ left: items[i].offsetLeft - list.offsetLeft - 20, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    list.addEventListener('scroll', () => requestAnimationFrame(syncMobile), { passive: true });
    syncMobile();
    desktop.addEventListener('change', () => {
      onScroll();
      syncMobile();
    });
  }
</script>
