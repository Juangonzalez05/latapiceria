---
// Arco (eco del respaldo de la silla del logo) como panel de fondo, con la foto COMPLETA delante.
// El arco ya no recorta la foto: asoma por encima y a los lados. La cúpula es un semicírculo exacto
// (radio = la mitad del ancho del marco).
import Foto from './Foto.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  eager?: boolean;
  quality?: number;
  class?: string;
}
const { src, alt, widths, sizes, eager = false, quality, class: cls = '' } = Astro.props;
---

<figure class:list={['arco', cls]}>
  <span class="arco-fondo" aria-hidden="true"></span>
  <Foto src={src} alt={alt} widths={widths} sizes={sizes} eager={eager} quality={quality} class="arco-foto" />
  <slot />
</figure>

<style>
  .arco {
    position: relative;
    margin: 0;
    /* Arriba asoma la cúpula; a los lados, un filo del arco. En % del ancho del marco. */
    padding: 26% 8% 0;
    isolation: isolate;
  }
  .arco-fondo {
    position: absolute;
    inset: 0 0 9% 0;
    z-index: -1;
    border-radius: 9999px 9999px var(--radius-card) var(--radius-card);
    background: var(--arco-color, var(--color-champana-200));
  }
  .arco :global(.arco-foto) {
    position: relative;
    box-shadow: 0 18px 40px -22px rgb(6 6 6 / 0.45);
  }
</style>
