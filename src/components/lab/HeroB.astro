---
// Concepto B · Mosaico de oficio: titular arriba y una tira de fotos verticales que cuenta
// «taller → tela → tapizado → en casa», unidas por el hilo del logo.
import { Image } from 'astro:assets';
import LabHeader from './LabHeader.astro';
import Pespunte from '../ui/Pespunte.astro';
import Icon from '../Icon.astro';
import { photo } from '../../lib/photos';
import { waLink } from '../../lib/whatsapp';
import { heroTrust } from './heroCopy';

const strip = [
  { slug: 'estructura-madera', label: 'Taller', alt: 'Carpintero armando la estructura en madera de un mueble', mobile: 'b' },
  { slug: 'muestrario-verde', label: 'Tela', alt: 'Muestras de telas en tonos verdes', mobile: 'c' },
  { slug: 'tapizando-verde', label: 'Tapizado', alt: 'Manos de tapicero ajustando la tela de un sillón', mobile: '' },
  { slug: 'hero-sofa', label: 'En casa', alt: 'Sofá modular claro sobre un camino entre árboles', mobile: 'a' },
];
---

<section id="concepto-b" class="hero-b relative flex min-h-svh flex-col overflow-hidden bg-crema-50" aria-labelledby="b-titulo">
  <LabHeader tone="light" />

  <div class="container-x flex flex-1 flex-col justify-center gap-8 pb-12 lg:gap-12 lg:pb-14">
    <div class="hero-b-copy grid grid-cols-[minmax(0,1fr)] gap-6 lg:grid-cols-12 lg:items-end lg:gap-12">
      <h1 id="b-titulo" class="hero-b-title text-negro lg:col-span-7">
        Tu mueble, como siempre <span class="italic text-esmeralda">lo imaginaste</span>
      </h1>
      <div class="lg:col-span-5 lg:pb-2">
        <p class="max-w-[30rem] text-[1.075rem] leading-relaxed text-gris md:text-[1.15rem]">
          Retapizamos, restauramos y fabricamos muebles a la medida. Cuéntanos tu idea y la llevamos a tu espacio.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
          <a href={waLink('Hola, quiero cotizar un trabajo con La Tapicería.')} class="btn btn-primary !min-h-[3.25rem] !px-7">
            <Icon name="whatsapp" size={20} />
            Cotizar por WhatsApp
          </a>
          <a href="#" class="inline-flex min-h-11 items-center justify-center gap-2 font-semibold text-negro">
            <span class="link-line">Ver proyectos</span>
            <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>
    </div>

    <!-- Escritorio: tira de 4 con desfase. Móvil: mosaico 1 grande + 2 pequeñas. -->
    <div class="relative">
      <Pespunte class="mb-4 hidden text-sepia lg:flex" />
      <ol class="hero-b-strip grid grid-cols-2 gap-3 lg:grid-cols-4 lg:gap-6">
        {strip.map((s, i) => (
          <li class:list={['hero-b-item', s.mobile ? `m-${s.mobile}` : 'max-lg:hidden']} style={`--i:${i}`}>
            <figure class="m-0">
              <div class="overflow-hidden rounded-[14px] bg-champana-200">
                <Image
                  src={photo(s.slug)}
                  alt={s.alt}
                  widths={[180, 290, 360, 580]}
                  sizes="(min-width: 1024px) 290px, 45vw"
                  class="hero-b-img h-full w-full object-cover"
                  loading="eager"
                />
              </div>
              <figcaption class="mt-2.5 flex items-baseline gap-2 text-[0.9rem] text-gris">
                <span class="font-serif text-terra-700 max-lg:hidden">{i + 1}</span>
                <span class="font-medium text-tinta">{s.label}</span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ol>
      <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-1 text-[0.9rem] text-gris lg:hidden">
        {heroTrust.slice(0, 2).map((t) => <li>{t}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero-b-title {
    font-size: clamp(2.5rem, 1.9rem + 2.6vw, 4.1rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
    max-width: 14ch;
  }
  @media (min-width: 1024px) {
    .hero-b-title {
      max-width: 17ch;
    }
  }
  .hero-b-img {
    aspect-ratio: 4 / 5;
  }
  /* Móvil: «En casa» grande a la izquierda (siempre visible), taller y tela apilados a la derecha. */
  @media (max-width: 1023.98px) {
    .hero-b-strip {
      grid-template-areas: 'a b' 'a c';
    }
    .m-a {
      grid-area: a;
    }
    .m-b {
      grid-area: b;
    }
    .m-c {
      grid-area: c;
    }
    .m-a .hero-b-img {
      aspect-ratio: auto;
      height: 100%;
      min-height: 15rem;
    }
    .m-a figure,
    .m-a figure > div {
      height: 100%;
    }
    .m-a figure {
      display: flex;
      flex-direction: column;
    }
    .m-a figure > div {
      flex: 1;
    }
    .m-b .hero-b-img,
    .m-c .hero-b-img {
      aspect-ratio: 4 / 3;
    }
  }
  @media (min-width: 1024px) {
    .hero-b-item:nth-child(2) {
      margin-top: 2rem;
    }
    .hero-b-item:nth-child(3) {
      margin-top: 0.75rem;
    }
    .hero-b-item:nth-child(4) {
      margin-top: 2.75rem;
    }
  }
  .hero-b-copy {
    animation: fade-up 900ms var(--ease-salida) 100ms both;
  }
  .hero-b-item {
    animation: fade-up 900ms var(--ease-salida) both;
    animation-delay: calc(300ms + var(--i) * 90ms);
  }
</style>
