---
// Banda «Hecho a mano» (campo esmeralda): el mensaje central del taller y calidad antes que cantidad.
import Todo from './Todo.astro';
import Foto from './ui/Foto.astro';
import Pespunte from './ui/Pespunte.astro';
import values from '../data/values.json';
import site from '../data/site.json';
import { photo } from '../lib/photos';
---

<section id="hecho-a-mano" class="section-y bg-esmeralda text-crema on-dark" aria-labelledby="intro-titulo">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4" data-reveal>
      <div class="mx-auto max-w-[22rem] lg:mx-0">
        <Foto
          src={photo('taller-estructura-curva')}
          alt="Artesano armando a mano la estructura curva de madera de un sofá en el taller"
          widths={[320, 440, 640, 704, 880]}
          sizes="(min-width: 640px) 352px, 88vw"
        />
      </div>
    </div>

    <div class="lg:col-span-8">
      <h2 id="intro-titulo" class="text-h2 !text-crema" data-reveal>
        Hecho a mano, <em class="text-champana">pieza por pieza</em>
      </h2>
      <p class="mt-6 max-w-[40rem] font-serif text-[clamp(1.2rem,1.1rem+0.5vw,1.5rem)] leading-relaxed text-crema/90" data-reveal>
        Preferimos hacer menos piezas y hacerlas bien: cada mueble pasa por las manos de quien lo diseña, lo corta, lo
        cose y lo revisa antes de llegar a tu espacio.
      </p>

      <Pespunte class="mt-10 max-w-[40rem] text-champana/70" />

      <ul class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
        {values.map((v, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <h3 class="font-serif text-[1.25rem] leading-snug !text-crema">{v.title}</h3>
            <p class="mt-2 text-small text-crema/80">{v.text}</p>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-2" data-reveal>
        {site.services.map((s) => (
          <span class="rounded-full border border-crema/30 px-3.5 py-1.5 text-small text-crema/90">{s}</span>
        ))}
        <Todo text={site.servicesTodo} />
      </div>
    </div>
  </div>
</section>
