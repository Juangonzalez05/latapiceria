---
// Telas y acabados: campo champaña («material»). Selector de muestras (radios nativos, flechas del teclado)
// que actualiza la foto, el resumen y el mensaje de WhatsApp. Foto destacada ≤ 448px CSS (nítida en 2x).
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import Pespunte from './ui/Pespunte.astro';
import fabrics from '../data/fabrics.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';

const msg = (name: string) => `Hola, me gustaría pedir una muestra de la tela «${name}». ¿Cómo la puedo recibir?`;
const first = fabrics[0];
---

<section id="telas" class="section-y bg-champana-200" aria-labelledby="telas-titulo" data-fabrics>
  <div class="container-x grid grid-cols-[minmax(0,1fr)] gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
    <div class="lg:col-span-6 lg:col-start-7 lg:row-start-1" data-reveal>
      <div class="frame relative mx-auto aspect-[4/5] w-full max-w-[28rem] bg-champana lg:mr-0">
        {fabrics.map((f, i) => (
          <Image
            src={photo(f.image)}
            alt={f.alt}
            widths={[360, 448, 720, 896]}
            sizes="(min-width: 640px) 448px, 90vw"
            class:list={['fabric-img absolute inset-0 h-full w-full object-cover', i === 0 && 'is-active']}
            data-fabric-img={f.id}
            aria-hidden={i === 0 ? undefined : 'true'}
          />
        ))}
        <span class="absolute bottom-3 left-3 rounded-full bg-crema/90 px-3.5 py-1.5 text-small font-medium text-negro" data-fabric-caption aria-hidden="true">{first.name}</span>
      </div>
    </div>

    <div class="lg:col-span-5 lg:row-start-1">
      <h2 id="telas-titulo" class="text-h2" data-reveal>Toca, elige, imagina</h2>
      <p class="lead mt-5 max-w-[30rem]" data-reveal>
        Algunas de las texturas con las que trabajamos. Elige una y te enviamos la muestra para que la veas en tu espacio.
      </p>

      <fieldset class="mt-9" data-reveal>
        <legend class="label mb-4">Elige una muestra</legend>
        <div class="flex flex-wrap gap-2 sm:gap-3">
          {fabrics.map((f, i) => (
            <label class="swatch relative cursor-pointer" title={f.name}>
              <input type="radio" name="tela" value={f.id} class="peer sr-only" checked={i === 0} data-fabric-input />
              <span class="swatch-ring block rounded-full p-[3px] transition-[box-shadow] duration-300 peer-checked:shadow-[0_0_0_2px_var(--color-terra-700)] peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-terra-700">
                <span class="block size-11 overflow-hidden rounded-full sm:size-14" style={`background:${f.swatch}`}>
                  <Image src={photo(f.image)} alt="" width={112} height={112} class="h-full w-full scale-150 object-cover" />
                </span>
              </span>
              <span class="sr-only">{f.name}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <Pespunte class="mt-8 max-w-[30rem] text-sepia-700/70" />

      <div class="mt-6 min-h-[11rem]" aria-live="polite">
        {fabrics.map((f, i) => (
          <div data-fabric-info={f.id} hidden={i !== 0} class="fabric-info">
            <h3 class="text-h3">{f.name}</h3>
            <p class="label mt-1">{f.family}</p>
            <p class="mt-3 max-w-[30rem] text-gris">{f.summary}</p>
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Usos recomendados">
              {f.uses.map((u) => <li class="rounded-full bg-crema-50/70 px-3 py-1 text-small">{u}</li>)}
            </ul>
          </div>
        ))}
        <Todo text="referencia, composición y disponibilidad de cada tela" class="mt-4" />
      </div>

      <a href={waLink(msg(first.name))} target="_blank" rel="noopener" class="btn btn-primary btn-lg mt-6" data-fabric-cta>
        <Icon name="whatsapp" size={20} />
        Pedir muestra por WhatsApp
        <Icon name="arrow" size={16} class="btn-arrow" />
      </a>
    </div>
  </div>
</section>

<style>
  .fabric-img {
    opacity: 0;
    transition: opacity 500ms var(--ease-suave);
  }
  .fabric-img.is-active {
    opacity: 1;
  }
  .fabric-info:not([hidden]) {
    animation: fade-only 350ms var(--ease-suave) both;
  }
  .swatch:hover .swatch-ring {
    box-shadow: 0 0 0 1px var(--color-sepia);
  }
</style>

<script>
  import { waLink } from '../lib/whatsapp';
  const root = document.querySelector<HTMLElement>('[data-fabrics]');
  if (root) {
    const cta = root.querySelector<HTMLAnchorElement>('[data-fabric-cta]')!;
    const caption = root.querySelector<HTMLElement>('[data-fabric-caption]')!;
    root.querySelectorAll<HTMLInputElement>('[data-fabric-input]').forEach((input) => {
      input.addEventListener('change', () => {
        const id = input.value;
        root.querySelectorAll<HTMLImageElement>('[data-fabric-img]').forEach((img) => {
          const on = img.dataset.fabricImg === id;
          img.classList.toggle('is-active', on);
          on ? img.removeAttribute('aria-hidden') : img.setAttribute('aria-hidden', 'true');
          if (on) img.loading = 'eager';
        });
        let name = '';
        root.querySelectorAll<HTMLElement>('[data-fabric-info]').forEach((el) => {
          el.hidden = el.dataset.fabricInfo !== id;
          if (!el.hidden) name = el.querySelector('h3')?.textContent ?? '';
        });
        caption.textContent = name;
        cta.href = waLink(`Hola, me gustaría pedir una muestra de la tela «${name}». ¿Cómo la puedo recibir?`);
      });
    });
  }
</script>
