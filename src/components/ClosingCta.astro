---
// Cierre: campo terra (acento cálido, texto crema AA 5,1:1) con foto en arco.
// Solo se muestran los datos de contacto reales; los faltantes son TODO en desarrollo.
import ArchFrame from './ui/ArchFrame.astro';
import Pespunte from './ui/Pespunte.astro';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import site from '../data/site.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';
import { SHOW_TODOS, has } from '../lib/flags';

const contact = [
  { key: 'whatsapp', icon: 'whatsapp', label: 'WhatsApp', value: site.whatsappDisplay, href: waLink(), todo: 'número de WhatsApp' },
  { key: 'email', icon: 'mail', label: 'Correo', value: site.email, href: site.email ? `mailto:${site.email}` : '', todo: 'correo' },
  { key: 'address', icon: 'pin', label: 'Taller', value: [site.address, site.city].filter(Boolean).join(', '), href: site.mapsUrl, todo: 'dirección, ciudad y enlace a Google Maps' },
  { key: 'hours', icon: 'clock', label: 'Horario', value: site.hours.join(' · '), href: '', todo: 'horario de atención' },
  { key: 'instagram', icon: 'instagram', label: 'Instagram', value: site.instagram, href: site.instagramUrl, todo: 'usuario de Instagram' },
] as const;
const rows = contact.filter((c) => has(c.value) || SHOW_TODOS);
---

<section id="contacto" class="section-y relative overflow-hidden bg-terra-700 text-crema on-dark" aria-labelledby="contacto-titulo">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 id="contacto-titulo" class="text-display !text-crema" data-reveal>¿Listo para empezar?</h2>
      <p class="mt-6 max-w-[34rem] text-lead text-crema/90" data-reveal>
        Cuéntanos qué mueble quieres renovar o qué pieza sueñas tener. Te respondemos por WhatsApp con calma y con todas las
        respuestas.
      </p>
      <div class="mt-9" data-reveal>
        <a href={waLink('Hola, estoy listo para empezar. Quiero cotizar con La Tapicería.')} target="_blank" rel="noopener" class="btn btn-light btn-lg">
          <Icon name="whatsapp" size={22} />
          Escríbenos por WhatsApp
          <Icon name="arrow" size={18} class="btn-arrow" />
        </a>
      </div>

      {rows.length > 0 && (
        <>
          <Pespunte class="mt-12 max-w-[34rem] text-crema/45" />
          <dl class="mt-8 grid max-w-[40rem] gap-x-10 gap-y-6 sm:grid-cols-2">
            {rows.map((c) => (
              <div data-reveal>
                <dt class="flex items-center gap-2 text-label font-semibold uppercase text-crema">
                  <Icon name={c.icon} size={16} />
                  {c.label}
                </dt>
                <dd class="mt-2">
                  {has(c.value) ? (
                    c.href ? (
                      <a class="link-line" href={c.href} target={c.key === 'email' ? undefined : '_blank'} rel="noopener">{c.value}</a>
                    ) : (
                      <span>{c.value}</span>
                    )
                  ) : (
                    <Todo text={c.todo} />
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </>
      )}
      {!has(site.coverage) && <Todo text="zona de cobertura" class="mt-6" />}
    </div>

    <div class="mx-auto w-full max-w-[18rem] sm:max-w-[22rem] lg:col-span-4 lg:col-start-9 lg:mx-0 lg:max-w-[25rem] lg:justify-self-end" data-reveal>
      <ArchFrame
        src={photo('sofa-hogar')}
        alt="Sofá claro con cojines en una sala iluminada por el sol"
        sizes="(min-width: 1024px) 400px, (min-width: 640px) 352px, 288px"
        widths={[288, 352, 400, 576, 704, 800, 963]}
        position="50% 60%"
      />
    </div>
  </div>
</section>
