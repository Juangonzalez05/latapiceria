---
// Banda de oficio: campo esmeralda (momento «profundo»), foto enmarcada y tres principios.
import { Image } from 'astro:assets';
import Todo from './Todo.astro';
import Pespunte from './ui/Pespunte.astro';
import values from '../data/values.json';
import site from '../data/site.json';
import { photo } from '../lib/photos';
---

<section class="section-y bg-esmeralda text-crema on-dark" aria-labelledby="intro-titulo">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4" data-reveal>
      <div class="frame mx-auto aspect-[4/5] max-w-[22rem] lg:mx-0">
        <Image
          src={photo('midiendo-madera')}
          alt="Manos de artesano marcando medidas sobre una tabla de madera"
          widths={[320, 440, 640, 880]}
          sizes="(min-width: 1024px) 352px, (min-width: 640px) 352px, 88vw"
          class="h-full w-full object-cover"
        />
      </div>
    </div>

    <div class="lg:col-span-8">
      <h2 id="intro-titulo" class="text-h2 !text-crema" data-reveal>
        Oficio, criterio y <em class="text-champana">calma</em>
      </h2>
      <p class="mt-6 max-w-[40rem] font-serif text-[clamp(1.2rem,1.1rem+0.5vw,1.5rem)] leading-relaxed text-crema/90" data-reveal>
        Somos un taller de diseño y producción. Escuchamos cómo vives tu espacio, te proponemos lo que mejor funciona y lo
        construimos con las manos, sin prisa y con atención a cada costura.
      </p>

      <Pespunte class="mt-10 max-w-[40rem] text-champana/70" />

      <ul class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
        {values.map((v, i) => (
          <li data-reveal style={`--reveal-delay:${i}`}>
            <h3 class="font-serif text-[1.25rem] leading-snug !text-crema">{v.title}</h3>
            <p class="mt-2 text-small text-crema/80">{v.text}</p>
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-wrap items-center gap-2" data-reveal>
        {site.services.map((s) => (
          <span class="rounded-full border border-crema/30 px-3.5 py-1.5 text-small text-crema/90">{s}</span>
        ))}
        <Todo text={site.servicesTodo} />
      </div>
    </div>
  </div>
</section>
