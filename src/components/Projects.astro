---
// Proyectos · selección curada de 6 piezas (calidad antes que cantidad), casi todas en cuero.
// Cada foto va completa, en su proporción. Escritorio: grilla editorial 5-4-3 / 3-4-5 (máx. ~490px CSS
// por foto, nítida en 2x): las horizontales van en las columnas anchas y las verticales en las angostas.
// Móvil: carrusel.
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Lightbox from './Lightbox.astro';
import Foto from './ui/Foto.astro';
import SectionHeader from './ui/SectionHeader.astro';
import data from '../data/projects.json';
import { photo } from '../lib/photos';

const items = await Promise.all(
  data.items.map(async (p) => {
    const src = photo(p.image);
    const full = await getImage({ src, width: Math.min(1100, src.width), format: 'webp', quality: 82 });
    return { ...p, full: full.src };
  })
);
---

<section id="proyectos" class="section-y overflow-hidden bg-crema" aria-labelledby="proyectos-titulo" data-projects>
  <div class="container-x">
    <SectionHeader id="proyectos-titulo" title={data.title} lead={data.lead} />

    <ul class="projects no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 items-end gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:snap-none lg:grid-cols-12 lg:items-start lg:gap-x-6 lg:gap-y-14 lg:overflow-visible lg:px-0 lg:pb-0" data-track aria-label="Proyectos">
      {items.map((p, i) => (
        <li class="project relative w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-auto" data-slot={i % 6}>
          <button
            type="button"
            class="group block w-full text-left"
            data-open-lightbox
            data-full={p.full}
            data-alt={p.alt}
            data-title={p.title}
            data-cat={p.note}
            aria-label={`Ampliar: ${p.title}`}
          >
            <span class="relative block">
              <Foto
                src={photo(p.image)}
                alt={p.alt}
                widths={[300, 400, 500, 640, 800, 1000]}
                sizes="(min-width: 1280px) 490px, (min-width: 1024px) 38vw, (min-width: 640px) 46vw, 78vw"
                imgClass="project-img"
              />
              <span class="absolute right-3 top-3 grid size-10 place-items-center rounded-full bg-crema/90 text-negro opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
                <Icon name="expand" size={16} />
              </span>
            </span>
            <span class="mt-3 block font-serif text-[1.15rem] text-negro">{p.title}</span>
            <span class="mt-0.5 block text-small text-gris">{p.note}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex justify-end gap-2 lg:hidden">
      <button type="button" class="carousel-arrow" aria-label="Proyecto anterior" data-prev><Icon name="arrow-left" /></button>
      <button type="button" class="carousel-arrow" aria-label="Proyecto siguiente" data-next><Icon name="arrow" /></button>
    </div>
  </div>

  <Lightbox />
</section>

<style>
  /* Sin zoom (recortaría los bordes de la foto): la foto se eleva con una sombra suave. */
  .project :global(.project-img) {
    transition: box-shadow 500ms var(--ease-salida);
  }
  @media (hover: hover) {
    .project:hover :global(.project-img) {
      box-shadow: 0 24px 44px -26px rgb(6 6 6 / 0.55);
    }
  }
  /* Escritorio: dos filas espejo (5-4-3 / 3-4-5 columnas de 12) con desfases suaves. */
  @media (min-width: 1024px) {
    .project[data-slot='0'],
    .project[data-slot='5'] {
      grid-column: span 5;
    }
    .project[data-slot='1'],
    .project[data-slot='4'] {
      grid-column: span 4;
    }
    .project[data-slot='2'],
    .project[data-slot='3'] {
      grid-column: span 3;
    }
    .project[data-slot='1'] {
      margin-top: 3rem;
    }
    .project[data-slot='3'] {
      margin-top: 1.5rem;
    }
    .project[data-slot='5'] {
      margin-top: 2.5rem;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const items = [...track.querySelectorAll<HTMLElement>('.project')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const step = () => (items[0] ? items[0].getBoundingClientRect().width + 16 : 300);
    const updateArrows = () => {
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 4));
      next.setAttribute('aria-disabled', String(track.scrollLeft + track.clientWidth >= track.scrollWidth - 4));
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', () => requestAnimationFrame(updateArrows), { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  }
</script>
