---
// Marco en arco (eco del respaldo de la silla del logo). Envuelve una imagen de Astro.
// El arco es un semicírculo exacto: radio = la mitad del ancho del marco.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Ancho máximo en px CSS. Mantenerlo ≤ ancho nativo / 2 para que no pixele en pantallas 2x. */
  maxWidth?: number;
  widths?: number[];
  sizes: string;
  eager?: boolean;
  position?: string;
  quality?: number;
  class?: string;
}
const { src, alt, maxWidth, widths, sizes, eager = false, position = '50% 100%', quality, class: cls = '' } = Astro.props;
const ratio = `${src.width} / ${src.height}`;
---

<figure class:list={['arch', cls]} style={`--arch-ratio:${ratio};${maxWidth ? `--arch-max:${maxWidth}px;` : ''}`}>
  <Image
    src={src}
    alt={alt}
    widths={widths ?? [360, 540, 720, src.width]}
    sizes={sizes}
    quality={quality}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    class="arch-img"
    style={`object-position:${position}`}
  />
  <slot />
</figure>

<style>
  .arch {
    position: relative;
    width: 100%;
    max-width: var(--arch-max, none);
    aspect-ratio: var(--arch-ratio);
    margin: 0;
    overflow: hidden;
    border-radius: 9999px 9999px var(--arch-foot, 6px) var(--arch-foot, 6px);
    background: var(--color-champana-200);
    isolation: isolate;
  }
  .arch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
