---
// Manifiesto · pausa de marca entre Trabajos (tela) y Cuero. Texto real del catálogo del cliente (p. 17).
// Campo champaña, una frase grande en Literata y una sola foto completa de detalle. Sin CTA: es un respiro.
import Foto from './ui/Foto.astro';
import Silla from './ui/Silla.astro';
import data from '../data/manifesto.json';
import site from '../data/site.json';
import { photo } from '../lib/photos';
---

<section class="section-y bg-champana-200" aria-label="Manifiesto">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <blockquote class="lg:col-span-7" data-reveal>
      <p class="manifesto-quote font-serif text-negro">
        {data.before}<em class="text-terra-700">{data.emphasis}</em>{data.after}
      </p>
      <p class="mt-7 max-w-[32rem] text-lead text-tinta/80">{data.body}</p>
      <footer class="mt-10 flex items-center gap-3 text-sepia-700">
        <Silla class="h-10 w-auto" />
        <span class="font-serif text-[1.05rem] italic" translate="no">{site.name}</span>
      </footer>
    </blockquote>

    <div class="mx-auto w-full max-w-[26rem] lg:col-span-5 lg:mr-0" data-reveal>
      <Foto
        src={photo(data.image)}
        alt={data.imageAlt}
        widths={[320, 416, 560, 640, 832, 1000]}
        sizes="(min-width: 1024px) 416px, (min-width: 640px) 416px, 88vw"
        class="manifesto-photo"
      />
    </div>
  </div>
</section>

<style>
  .manifesto-quote {
    font-size: clamp(1.95rem, 1.35rem + 2.6vw, 3.35rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    text-wrap: balance;
    max-width: 22ch;
  }
  :global(.manifesto-photo) {
    box-shadow: 0 26px 50px -30px rgb(6 6 6 / 0.5);
  }
</style>
