---
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sectors from '../components/Sectors.astro';
import Intro from '../components/Intro.astro';
import Leather from '../components/Leather.astro';
import Projects from '../components/Projects.astro';
import Lightbox from '../components/Lightbox.astro';
import Process from '../components/Process.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Fabrics from '../components/Fabrics.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Conditions from '../components/Conditions.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!--
  Recorrido B2B (mismo equilibrio que el catálogo del cliente): oferta (hero, tela y cuero) → para quién
  (sectores) → hecho a mano (taller) → trabajos en tela → cuero (sección exclusiva, la especialidad) →
  del boceto a la pieza (los dos pares) → proceso → telas → cotizar → dudas → cierre.
-->
<Base>
  <AnnouncementBar />
  <Header />
  <main id="contenido">
    <Hero />
    <Sectors />
    <Intro />
    <Projects />
    <Leather />
    <BeforeAfter />
    <Process />
    <Fabrics />
    <QuoteWizard />
    <Conditions />
    <Faq />
    <Testimonials />
    <ClosingCta />
  </main>
  <Footer />
  <WhatsAppFloat />
  <!-- Un solo visor para todas las galerías (trabajos en tela y piezas en cuero), por grupos. -->
  <Lightbox />
</Base>
