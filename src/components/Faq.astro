---
// Preguntas frecuentes: acordeón nativo (<details name> = uno abierto a la vez), encabezado lateral fijo.
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import SectionHeader from './ui/SectionHeader.astro';
import faq from '../data/faq.json';
import { waLink } from '../lib/whatsapp';
---

<section id="preguntas" class="section-y bg-crema-50" aria-labelledby="faq-titulo">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-4">
      <SectionHeader id="faq-titulo" variant="aside" title="Lo que suelen preguntarnos" lead="¿Tienes otra duda? Escríbenos y te respondemos por WhatsApp.">
        <a href={waLink('Hola, tengo una pregunta sobre su servicio.')} target="_blank" rel="noopener" class="link-arrow mt-4 text-esmeralda">
          <Icon name="whatsapp" size={18} />
          <span class="link-line">Hacer una pregunta</span>
        </a>
      </SectionHeader>
    </div>
    <div class="border-t border-negro/15 lg:col-span-8">
      {faq.map((f, i) => (
        <details class="faq group border-b border-negro/15" name="faq" data-reveal style={`--reveal-delay:${Math.min(i, 3)}`}>
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 font-serif text-[clamp(1.15rem,1.08rem+0.35vw,1.4rem)] leading-snug transition-colors hover:text-terra-700 md:py-6 [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid size-11 shrink-0 place-items-center rounded-full border border-negro/20 transition-transform duration-300 group-open:rotate-45" aria-hidden="true" data-motion="transform">
              <Icon name="plus" size={18} />
            </span>
          </summary>
          <div class="max-w-2xl pb-7 pr-14 text-gris">
            <p>{f.a}</p>
            {f.todo && <Todo text={f.todo} class="mt-3" />}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq::details-content {
    block-size: 0;
    overflow: hidden;
    transition:
      block-size 400ms var(--ease-salida),
      content-visibility 400ms allow-discrete;
  }
  .faq[open]::details-content {
    block-size: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .faq::details-content {
      transition: none;
    }
  }
</style>
