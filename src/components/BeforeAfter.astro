---
// Del boceto a la pieza: los dos pares, visibles a la vez (lado a lado en escritorio, uno debajo del otro
// en móvil). Cada slider toma la proporción real de su par (las dos fotos se igualan en npm run media):
// nada se recorta. Ancho ≤ ~560px CSS (orígenes de 977 y 1143px, nítidos en 2x).
// En producción solo se muestran pares con ambas fotos; los pendientes quedan como TODO en desarrollo.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import allPairs from '../data/beforeAfter.json';
import { photo } from '../lib/photos';
import { SHOW_TODOS } from '../lib/flags';

const pairs = allPairs.filter((p) => p.before && p.after);
const pending = SHOW_TODOS ? allPairs.filter((p) => !(p.before && p.after)) : [];
const ratio = (slug: string) => `${photo(slug).width} / ${photo(slug).height}`;
---

{pairs.length > 0 && (
  <section id="boceto-a-pieza" class="section-y bg-esmeralda-900 text-crema on-dark" aria-labelledby="ba-titulo">
    <div class="container-x">
      <div class="mb-head grid grid-cols-[minmax(0,1fr)] gap-5 md:grid-cols-12 md:items-end md:gap-10" data-reveal>
        <h2 id="ba-titulo" class="text-h2 !text-crema md:col-span-7">Del boceto <em class="text-champana">a la pieza</em></h2>
        <div class="md:col-span-5 md:justify-self-end">
          <p class="lead max-w-[30rem]">
            Primero el diseño o la estructura; después, la pieza terminada. Arrastra la línea para comparar.
          </p>
          <p class="mt-4 hidden items-center gap-2 text-small text-crema/75 lg:flex">
            <Icon name="drag" size={18} />
            También con las flechas del teclado.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-[minmax(0,1fr)] gap-14 lg:grid-cols-2 lg:gap-10">
        {pairs.map((p) => (
          <figure class="mx-auto w-full" style={`max-width: min(35rem, ${Math.floor(photo(p.after).width / 2)}px)`} data-reveal="fade">
            <figcaption class="mb-4 flex items-baseline justify-between gap-4">
              <span class="font-serif text-[1.3rem] leading-snug text-crema">{p.label}</span>
              <span class="hidden shrink-0 text-small text-crema/75 sm:inline">{p.beforeLabel} → {p.afterLabel}</span>
            </figcaption>
            <div class="ba relative w-full touch-pan-y select-none overflow-hidden rounded-card bg-esmeralda" data-ba style={`--pos: 50%; aspect-ratio: ${ratio(p.after)}`}>
              <Image src={photo(p.after)} alt={p.afterAlt} widths={[400, 560, 800, 977, 1120]} sizes="(min-width: 1024px) 560px, 92vw" class="absolute inset-0 h-full w-full" draggable="false" />
              <div class="ba-before absolute inset-0">
                <Image src={photo(p.before)} alt={p.beforeAlt} widths={[400, 560, 800, 977, 1120]} sizes="(min-width: 1024px) 560px, 92vw" class="absolute inset-0 h-full w-full" draggable="false" />
              </div>

              <span class="pointer-events-none absolute left-3 top-3 rounded-full bg-negro/65 px-3 py-1 text-label font-semibold uppercase text-crema">{p.beforeLabel}</span>
              <span class="pointer-events-none absolute right-3 top-3 rounded-full bg-crema/90 px-3 py-1 text-label font-semibold uppercase text-negro">{p.afterLabel}</span>

              <div
                class="ba-handle absolute inset-y-0 w-11 -translate-x-1/2 cursor-ew-resize"
                role="slider"
                tabindex="0"
                aria-label={`${p.label}: comparar ${p.beforeLabel.toLowerCase()} y ${p.afterLabel.toLowerCase()}`}
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="50"
                aria-valuetext={`50% ${p.beforeLabel.toLowerCase()}`}
                data-ba-handle
              >
                <span class="absolute inset-y-0 left-1/2 w-px -translate-x-1/2 bg-crema" aria-hidden="true" />
                <span class="ba-knob absolute left-1/2 top-1/2 grid size-12 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-crema text-negro shadow-soft" aria-hidden="true">
                  <Icon name="drag" size={20} />
                </span>
              </div>
            </div>
          </figure>
        ))}
      </div>
      {pending.map((p) => p.todo && <p class="mt-8"><Todo text={p.todo} /></p>)}
    </div>
  </section>
)}

<style>
  .ba-before {
    clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  }
  .ba-handle {
    left: var(--pos);
  }
  .ba-knob {
    transition: transform 250ms var(--ease-salida);
  }
  .ba-handle:hover .ba-knob,
  .ba[data-dragging] .ba-knob {
    transform: scale(1.08);
  }
  .ba-handle:focus-visible {
    outline: none;
  }
  .ba-handle:focus-visible .ba-knob {
    outline: 2px solid var(--color-champana);
    outline-offset: 3px;
  }
</style>

<script>
  // Slider antes/después: arrastre con puntero + teclado (flechas, Re Pág/Av Pág, Inicio/Fin).
  document.querySelectorAll<HTMLElement>('[data-ba]').forEach((box) => {
    const handle = box.querySelector<HTMLElement>('[data-ba-handle]')!;
    const label = (handle.getAttribute('aria-valuetext') || '').replace(/^\d+%\s*/, '');
    let pos = 50;

    const set = (v: number) => {
      pos = Math.round(Math.min(100, Math.max(0, v)));
      box.style.setProperty('--pos', `${pos}%`);
      handle.setAttribute('aria-valuenow', String(pos));
      handle.setAttribute('aria-valuetext', `${pos}% ${label}`);
    };
    const fromEvent = (e: PointerEvent) => {
      const r = box.getBoundingClientRect();
      set(((e.clientX - r.left) / r.width) * 100);
    };

    box.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      box.setPointerCapture(e.pointerId);
      box.toggleAttribute('data-dragging', true);
      fromEvent(e);
      handle.focus({ preventScroll: true });
    });
    box.addEventListener('pointermove', (e) => {
      if (box.hasPointerCapture(e.pointerId)) fromEvent(e);
    });
    const end = (e: PointerEvent) => {
      if (box.hasPointerCapture(e.pointerId)) box.releasePointerCapture(e.pointerId);
      box.removeAttribute('data-dragging');
    };
    box.addEventListener('pointerup', end);
    box.addEventListener('pointercancel', end);
    // Si se pierde la captura (gesto interrumpido, cambio de ventana), el estado de arrastre no queda pegado.
    box.addEventListener('lostpointercapture', () => box.removeAttribute('data-dragging'));

    handle.addEventListener('keydown', (e) => {
      const step = e.shiftKey ? 10 : 2;
      const map: Record<string, number> = {
        ArrowLeft: pos - step,
        ArrowDown: pos - step,
        ArrowRight: pos + step,
        ArrowUp: pos + step,
        PageDown: pos - 10,
        PageUp: pos + 10,
        Home: 0,
        End: 100,
      };
      if (e.key in map) {
        e.preventDefault();
        set(map[e.key]);
      }
    });
  });
</script>
