---
// Sectores: hoteles, restaurantes, galerías y casas de arquitecto (reemplaza «Dos caminos»).
// Escritorio: 4 columnas; cada foto va completa, apoyada sobre una base común (caja 3:4) para que los
// títulos queden alineados (≤ 300px CSS, nítida en 2x). Móvil: carrusel deslizable.
import Icon from './Icon.astro';
import Foto from './ui/Foto.astro';
import Todo from './Todo.astro';
import SectionHeader from './ui/SectionHeader.astro';
import data from '../data/sectors.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';
---

<section id="sectores" class="section-y overflow-hidden bg-crema-50" aria-labelledby="sectores-titulo" data-sectors>
  <div class="container-x">
    <SectionHeader id="sectores-titulo" title={data.title} lead={data.lead} />

    <ul class="no-scrollbar -mx-5 flex snap-x snap-mandatory scroll-px-5 gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:snap-none lg:grid-cols-4 lg:gap-6 lg:overflow-visible lg:px-0 lg:pb-0" data-sector-track aria-label="Sectores">
      {data.items.map((s, i) => (
        <li class="sector group relative w-[76%] shrink-0 snap-start sm:w-[44%] lg:w-auto" data-reveal style={`--reveal-delay:${i}`}>
          <article aria-labelledby={`sector-${s.id}`} class="flex h-full flex-col">
            <Foto
              src={photo(s.image)}
              alt={s.alt}
              widths={[280, 300, 420, 560, 600]}
              sizes="(min-width: 1024px) 300px, (min-width: 640px) 44vw, 76vw"
              box={3 / 4}
              imgClass="sector-img"
            />
            <h3 id={`sector-${s.id}`} class="mt-5 text-h3">{s.name}</h3>
            <p class="mt-2 text-gris">{s.text}</p>
            {s.todo && <Todo text={s.todo} class="mt-3" />}
            <a href={waLink(s.message)} target="_blank" rel="noopener" class="link-arrow mt-auto pt-4 text-esmeralda">
              <Icon name="whatsapp" size={18} />
              <span class="link-line">{s.cta}</span>
              <Icon name="arrow" size={16} class="btn-arrow" />
            </a>
          </article>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex items-center justify-between gap-4 lg:hidden">
      <p class="text-small text-gris" aria-live="polite" data-sector-count>1 de {data.items.length}</p>
      <div class="flex gap-2">
        <button type="button" class="carousel-arrow" aria-label="Sector anterior" data-sector-prev><Icon name="arrow-left" /></button>
        <button type="button" class="carousel-arrow" aria-label="Sector siguiente" data-sector-next><Icon name="arrow" /></button>
      </div>
    </div>

    <p class="mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-negro/10 pt-6 text-gris lg:mt-14" data-reveal>
      <span>{data.home.text}</span>
      <a href={waLink(data.home.message)} target="_blank" rel="noopener" class="link-arrow text-negro">
        <span class="link-line">{data.home.cta}</span>
        <Icon name="arrow" size={16} class="btn-arrow" />
      </a>
    </p>
  </div>
</section>

<style>
  /* Sin zoom (recortaría los bordes de la foto): la foto se eleva con una sombra suave. */
  .sector :global(.sector-img) {
    transition: box-shadow 500ms var(--ease-salida);
  }
  @media (hover: hover) {
    .sector:hover :global(.sector-img) {
      box-shadow: 0 22px 40px -24px rgb(6 6 6 / 0.55);
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-sectors]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-sector-track]')!;
    const items = [...track.querySelectorAll<HTMLElement>('.sector')];
    const prev = root.querySelector<HTMLButtonElement>('[data-sector-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-sector-next]')!;
    const count = root.querySelector<HTMLElement>('[data-sector-count]')!;
    const index = () => {
      const w = items[0].getBoundingClientRect().width + 16;
      return Math.min(items.length - 1, Math.max(0, Math.round(track.scrollLeft / w)));
    };
    const sync = () => {
      const i = index();
      count.textContent = `${i + 1} de ${items.length}`;
      prev.setAttribute('aria-disabled', String(i === 0));
      next.setAttribute('aria-disabled', String(i === items.length - 1));
    };
    const go = (d: number) => {
      const i = Math.min(items.length - 1, Math.max(0, index() + d));
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollTo({ left: items[i].offsetLeft - track.offsetLeft - 20, behavior: smooth ? 'smooth' : 'auto' });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    sync();
  }
</script>
