---
// Banda «Hecho a mano» (campo esmeralda): el mensaje central del taller y calidad antes que cantidad.
// Foto del taller real y, debajo, «Manos que saben» (catálogo del cliente): el oficio en tela y madera,
// con fotos completas apoyadas sobre una misma base (mismo patrón que «Del corte al capitoné» en Cuero).
// Dirección de arte: el taller va en blanco y negro (filtro CSS, el archivo no cambia) y recupera el color al
// pasar el mouse; las piezas terminadas del resto de la página siempre van a color.
import Todo from './Todo.astro';
import Foto from './ui/Foto.astro';
import Pespunte from './ui/Pespunte.astro';
import values from '../data/values.json';
import taller from '../data/taller.json';
import site from '../data/site.json';
import { photo } from '../lib/photos';

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="hecho-a-mano" class="section-y bg-esmeralda text-crema on-dark" aria-labelledby="intro-titulo">
  <div class="container-x">
    <div class="grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <div class="mx-auto max-w-[22rem] lg:mx-0">
          <Foto
            src={photo(taller.photo)}
            alt={taller.photoAlt}
            widths={[320, 440, 640, 704, 880]}
            sizes="(min-width: 640px) 352px, 88vw"
            class="!bg-esmeralda-800"
          />
        </div>
      </div>

      <div class="lg:col-span-8">
        <h2 id="intro-titulo" class="text-h2 !text-crema" data-reveal>
          Hecho a mano, <em class="text-champana">pieza por pieza</em>
        </h2>
        <p class="mt-6 max-w-[40rem] font-serif text-[clamp(1.2rem,1.1rem+0.5vw,1.5rem)] leading-relaxed text-crema/90" data-reveal>
          Preferimos hacer menos piezas y hacerlas bien: cada mueble pasa por las manos de quien lo diseña, lo corta, lo
          cose y lo revisa antes de llegar a tu espacio.
        </p>

        <Pespunte class="mt-10 max-w-[40rem] text-champana/70" />

        <ul class="mt-8 grid gap-8 sm:grid-cols-3 sm:gap-6">
          {values.map((v, i) => (
            <li data-reveal style={`--reveal-delay:${i}`}>
              <h3 class="font-serif text-[1.25rem] leading-snug !text-crema">{v.title}</h3>
              <p class="mt-2 text-small text-crema/80">{v.text}</p>
            </li>
          ))}
        </ul>

        <div class="mt-10 flex flex-wrap items-center gap-2" data-reveal>
          {site.services.map((s) => (
            <span class="rounded-full border border-crema/30 px-3.5 py-1.5 text-small text-crema/90">{s}</span>
          ))}
          <Todo text={site.servicesTodo} />
        </div>
      </div>
    </div>

    <!-- Manos que saben: el oficio del taller, fotos completas sobre una misma línea -->
    <div class="mt-20 border-t border-crema/15 pt-12 lg:mt-24 lg:pt-16">
      <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-3" data-reveal>
        <h3 class="text-h3 !text-crema">{taller.title} <em class="text-champana">{taller.emphasis}</em></h3>
        <p class="max-w-[28rem] text-small text-crema/80">{taller.lead}</p>
      </div>
      <ul class="taller-strip no-scrollbar -mx-5 mt-8 flex snap-x snap-mandatory scroll-px-5 items-end gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:grid-cols-4 lg:gap-x-5 lg:gap-y-10 lg:overflow-visible lg:px-0 lg:pb-0" aria-label="El oficio del taller" tabindex="0">
        {taller.items.map((d, i) => (
          <li class="w-[56%] shrink-0 snap-start sm:w-[32%] lg:w-auto" data-reveal style={`--reveal-delay:${i % 4}`}>
            <figure>
              <Foto
                src={photo(d.image)}
                alt={d.alt}
                widths={[200, 240, 288, 400, 576]}
                sizes="(min-width: 1024px) 288px, (min-width: 640px) 32vw, 56vw"
                class="!bg-esmeralda-800"
              />
              <figcaption class="mt-3 text-small text-crema/80">
                <span class="text-champana">{pad(i + 1)}</span> · {d.title}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .taller-strip :global(.foto) {
    filter: grayscale(1) contrast(1.06);
    transition: filter 400ms var(--ease-suave);
  }
  @media (hover: hover) {
    .taller-strip li:hover :global(.foto) {
      filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .taller-strip :global(.foto) {
      transition: none;
    }
  }
</style>
