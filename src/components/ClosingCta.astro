---
// Cierre: campo terra (acento cálido, texto crema AA 5,1:1) con la foto completa delante de un arco,
// firmado con el eslogan de la marca.
// Solo se muestran los datos de contacto que existen en site.json; los vacíos no dejan hueco.
import ArchFrame from './ui/ArchFrame.astro';
import Pespunte from './ui/Pespunte.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';
import { has } from '../lib/flags';

const contact = [
  {
    key: 'whatsapp',
    icon: 'whatsapp',
    label: 'WhatsApp',
    value: site.whatsappDisplay,
    href: waLink('¡Hola! Quisiera hablar con el taller. ¿Me orientan sobre fabricación a medida y retapizado?'),
  },
  { key: 'email', icon: 'mail', label: 'Correo', value: site.email, href: site.email ? `mailto:${site.email}` : '' },
  { key: 'address', icon: 'pin', label: 'Taller', value: [site.address, site.city].filter(Boolean).join(', '), href: site.mapsUrl },
  { key: 'hours', icon: 'clock', label: 'Horario', value: site.hours.join(' · '), href: '' },
  { key: 'instagram', icon: 'instagram', label: 'Instagram', value: site.instagram, href: site.instagramUrl },
] as const;
const rows = contact.filter((c) => has(c.value));
---

<section id="contacto" class="section-y relative overflow-hidden bg-terra-700 text-crema on-dark" aria-labelledby="contacto-titulo">
  <div class="container-x grid grid-cols-[minmax(0,1fr)] items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-7">
      <h2 id="contacto-titulo" class="text-display !text-crema" data-reveal>¿Tienes un proyecto en mente?</h2>
      <p class="mt-6 max-w-[34rem] text-lead text-crema/90" data-reveal>
        Escríbenos con el tipo de espacio, la cantidad aproximada de piezas y tus referencias. Te respondemos por WhatsApp,
        con calma y con todas las respuestas.
      </p>
      <p class="mt-4 font-serif text-[1.25rem] italic text-crema" data-reveal>{site.tagline}.</p>
      <div class="mt-9" data-reveal>
        <a href={waLink('¡Hola, La Tapicería! Tengo un proyecto en mente. ¿Puedo contarles cómo es el espacio y qué piezas necesito para recibir una cotización?')} target="_blank" rel="noopener" class="btn btn-light btn-lg">
          <Icon name="whatsapp" size={22} />
          Hablemos de tu proyecto
          <Icon name="arrow" size={18} class="btn-arrow" />
        </a>
      </div>

      {rows.length > 0 && (
        <>
          <Pespunte class="mt-12 max-w-[34rem] text-crema/45" />
          <dl class="mt-8 grid max-w-[40rem] gap-x-10 gap-y-6 sm:grid-cols-2">
            {rows.map((c) => (
              <div data-reveal>
                <dt class="flex items-center gap-2 text-label font-semibold uppercase text-crema">
                  <Icon name={c.icon} size={16} />
                  {c.label}
                </dt>
                <dd class="mt-2">
                  {c.href ? (
                    <a class="link-line" href={c.href} target={c.key === 'email' ? undefined : '_blank'} rel="noopener">{c.value}</a>
                  ) : (
                    <span>{c.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </>
      )}
      {has(site.coverage) && <p class="mt-6 max-w-[34rem] text-small text-crema/85">Visitas técnicas e instalación en {site.coverage}. Fuera del área metropolitana, lo cotizamos aparte.</p>}
    </div>

    <div class="mx-auto w-full max-w-[18rem] sm:max-w-[22rem] lg:col-span-4 lg:col-start-9 lg:mx-0 lg:max-w-[25rem] lg:justify-self-end" data-reveal>
      <ArchFrame
        src={photo('cama-noche')}
        alt="Cama con cabecero redondeado tapizado en tela clara, iluminada por una lámpara cálida de noche"
        sizes="(min-width: 1024px) 336px, (min-width: 640px) 296px, 242px"
        widths={[242, 296, 336, 484, 592, 672, 800]}
        class="[--arco-color:var(--color-terra)]"
      />
    </div>
  </div>
</section>
