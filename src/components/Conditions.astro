---
// Condiciones del servicio. En producción solo se muestran las que tienen texto real;
// si ninguna lo tiene, la sección no se renderiza (sin huecos).
import Todo from './Todo.astro';
import conditions from '../data/conditions.json';
import { SHOW_TODOS, has } from '../lib/flags';

const items = conditions.filter((c) => has(c.text) || SHOW_TODOS);
---

{items.length > 0 && (
  <section class="bg-crema-50 pt-[var(--spacing-section)]" aria-labelledby="condiciones-titulo">
    <div class="container-x grid grid-cols-[minmax(0,1fr)] gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-4" data-reveal>
        <h2 id="condiciones-titulo" class="text-h2">Claro desde el principio</h2>
        <p class="lead mt-5 max-w-[24rem]">Lo que necesitas saber antes de empezar, sin letra pequeña.</p>
      </div>
      <dl class="grid gap-px overflow-hidden rounded-card bg-negro/10 sm:grid-cols-2 lg:col-span-8">
        {items.map((c, i) => (
          <div class="bg-crema p-6 md:p-8" data-reveal style={`--reveal-delay:${i}`}>
            <dt class="text-h3">{c.title}</dt>
            <dd class="mt-3 text-gris">{has(c.text) ? c.text : <Todo text={c.todo} />}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
)}
