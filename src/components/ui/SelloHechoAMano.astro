---
// Sello «Hecho a mano»: texto circular alrededor de la silla del logo. Decorativo (el mensaje
// ya está en el texto de la página), estático y en la paleta: anillo sepia, silla y texto terra.
interface Props {
  class?: string;
  text?: string;
}
const { class: cls = '', text = 'Hecho a mano · Diseño y producción · ' } = Astro.props;
const id = `sello-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['sello', cls]} viewBox="0 0 140 140" aria-hidden="true" focusable="false">
  <defs>
    <path id={id} d="M70,70 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0" />
  </defs>
  <circle cx="70" cy="70" r="68" fill="var(--color-crema-50)" />
  <circle cx="70" cy="70" r="66" fill="none" stroke="var(--color-sepia)" stroke-width="1" />
  <circle cx="70" cy="70" r="38" fill="none" stroke="var(--color-sepia)" stroke-width="0.8" stroke-dasharray="3 3" />
  <text class="sello-texto" fill="var(--color-terra-700)">
    <textPath href={`#${id}`} textLength="324" lengthAdjust="spacing">{text.toUpperCase()}</textPath>
  </text>
  <!-- Silla del logo (misma silueta que el cursor), centrada -->
  <g transform="translate(51 50) scale(1.2)" fill="none" stroke="var(--color-terra-700)" stroke-width="1.4" stroke-linejoin="round">
    <rect x="8.6" y="19" width="2.6" height="7.5" rx="1.2" />
    <rect x="18.8" y="19" width="2.6" height="7.5" rx="1.2" />
    <rect x="7" y="6.5" width="2.6" height="9.5" rx="1.2" />
    <rect x="17.4" y="6.5" width="2.6" height="9.5" rx="1.2" />
    <ellipse cx="14" cy="17.2" rx="10.5" ry="3" fill="var(--color-crema-50)" />
    <rect x="5" y="2.5" width="18" height="5" rx="2.5" fill="var(--color-crema-50)" />
    <circle cx="20.5" cy="5" r="1.2" />
    <rect x="3.6" y="18.5" width="2.8" height="11" rx="1.3" fill="var(--color-crema-50)" />
    <rect x="15.6" y="19.5" width="2.8" height="11" rx="1.3" fill="var(--color-crema-50)" />
  </g>
</svg>

<style>
  .sello {
    display: block;
    filter: drop-shadow(0 10px 18px rgb(6 6 6 / 0.18));
  }
  .sello-texto {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
</style>
