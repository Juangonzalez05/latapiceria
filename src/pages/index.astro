---
import Base from '../layouts/Base.astro';
import AnnouncementBar from '../components/AnnouncementBar.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Sectors from '../components/Sectors.astro';
import Intro from '../components/Intro.astro';
import Leather from '../components/Leather.astro';
import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Fabrics from '../components/Fabrics.astro';
import QuoteWizard from '../components/QuoteWizard.astro';
import Conditions from '../components/Conditions.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import ClosingCta from '../components/ClosingCta.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
---

<!--
  Recorrido B2B: oferta (hero) → para quién (sectores) → hecho a mano → cuero (especialidad) →
  prueba (proyectos curados) → proceso → materia (antes/después, telas) → cotizar → dudas → cierre.
-->
<Base>
  <AnnouncementBar />
  <Header />
  <main id="contenido">
    <Hero />
    <Sectors />
    <Intro />
    <Leather />
    <Projects />
    <Process />
    <BeforeAfter />
    <Fabrics />
    <QuoteWizard />
    <Conditions />
    <Faq />
    <Testimonials />
    <ClosingCta />
  </main>
  <Footer />
  <WhatsAppFloat />
</Base>
