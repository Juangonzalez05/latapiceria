---
// Concepto A · Editorial enmarcado: fondo crema, titular en 3 líneas, foto vertical en arco.
import { Image } from 'astro:assets';
import LabHeader from './LabHeader.astro';
import ArchFrame from '../ui/ArchFrame.astro';
import Pespunte from '../ui/Pespunte.astro';
import Icon from '../Icon.astro';
import { photo } from '../../lib/photos';
import { waLink } from '../../lib/whatsapp';
import { heroTrust } from './heroCopy';
---

<section id="concepto-a" class="hero-a relative flex min-h-svh flex-col overflow-hidden bg-crema" aria-labelledby="a-titulo">
  <LabHeader tone="light" />

  <div class="container-x grid flex-1 grid-cols-[minmax(0,1fr)] items-center gap-9 pb-14 pt-2 lg:grid-cols-12 lg:gap-12 lg:pb-20 lg:pt-0">
    <div class="relative order-1 mx-auto w-full max-w-[17.5rem] sm:max-w-[21rem] lg:order-2 lg:col-span-5 lg:col-start-8 lg:mx-0 lg:max-w-[29rem] lg:justify-self-end">
      <div class="hero-a-arch">
        <ArchFrame
          src={photo('hero-arco')}
          alt="Sofá modular claro en medio de un camino entre árboles"
          sizes="(min-width: 1024px) 464px, (min-width: 640px) 336px, 280px"
          widths={[280, 336, 464, 560, 672, 928, 1081]}
          eager
        />
      </div>
      <div class="hero-a-detalle absolute -bottom-7 -left-5 w-[34%] overflow-hidden rounded-[14px] shadow-[0_18px_40px_-18px_rgb(6_6_6/0.45)] ring-[6px] ring-crema sm:-left-10 lg:-bottom-10 lg:-left-16 lg:w-[36%]">
        <Image
          src={photo('tapizando-verde')}
          alt="Manos de tapicero ajustando la tela de un sillón"
          widths={[120, 200, 340]}
          sizes="(min-width: 1024px) 168px, 96px"
          class="aspect-[4/5] h-full w-full object-cover"
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-a-copy order-2 lg:order-1 lg:col-span-7 lg:pr-6">
      <h1 id="a-titulo" class="hero-a-title text-negro">
        <span>Tu mueble,</span>
        <span>como siempre</span>
        <span class="italic text-esmeralda">lo imaginaste</span>
      </h1>
      <p class="mt-6 max-w-[34rem] text-[1.075rem] leading-relaxed text-gris md:text-[1.2rem]">
        Retapizamos, restauramos y fabricamos muebles a la medida. Cuéntanos tu idea y la llevamos a tu espacio.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
        <a href={waLink('Hola, quiero cotizar un trabajo con La Tapicería.')} class="btn btn-primary !min-h-[3.25rem] !px-7">
          <Icon name="whatsapp" size={20} />
          Cotizar por WhatsApp
        </a>
        <a href="#" class="inline-flex min-h-11 items-center justify-center gap-2 font-semibold text-negro">
          <span class="link-line">Ver proyectos</span>
          <Icon name="arrow" size={16} />
        </a>
      </div>
      <div class="mt-10 max-w-[34rem]">
        <Pespunte class="text-sepia" />
        <ul class="hero-trust mt-4 grid gap-1.5 text-[0.95rem] text-gris sm:flex sm:flex-wrap sm:gap-x-5">
          {heroTrust.map((t) => <li>{t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-a-title {
    font-size: clamp(2.5rem, 2rem + 3.4vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
  }
  .hero-a-title span {
    display: block;
  }
  /* Separador entre datos de confianza solo cuando van en fila. */
  @media (min-width: 640px) {
    .hero-trust li + li::before {
      content: '';
      display: inline-block;
      width: 4px;
      height: 4px;
      margin: 0 1.1rem 0.2em 0;
      border-radius: 50%;
      background: var(--color-sepia);
      vertical-align: middle;
    }
  }
  /* Una sola entrada: el arco se descubre de abajo hacia arriba y el texto sube con él. */
  .hero-a-arch {
    animation: arch-in 1100ms var(--ease-salida) both;
  }
  .hero-a-detalle {
    animation: fade-up 900ms var(--ease-salida) 450ms both;
  }
  .hero-a-copy {
    animation: fade-up 900ms var(--ease-salida) 150ms both;
  }
  @keyframes arch-in {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
