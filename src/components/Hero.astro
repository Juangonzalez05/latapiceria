---
// Hero · banner con una sola foto grande (el sofá frente a la pared de listones) y el texto debajo,
// enfocado a hoteles, restaurantes, galerías y casas de arquitecto.
// La foto mide 1170px de ancho (exporte de WhatsApp): para no ampliarla, en escritorio ocupa el ancho del
// contenido (≤ 1224px), no el de la pantalla, y en el celular va de borde a borde en su proporción natural.
// Única excepción a «fotos sin recorte» (data-crop-ok): desde 640px el banner tiene proporción fija y solo
// pierde pared arriba y piso abajo; el sofá y las mesas auxiliares quedan completos (object-position 50% 80%).
// El sello «Hecho a mano» va montado sobre el borde inferior derecho del banner.
import { Image } from 'astro:assets';
import Pespunte from './ui/Pespunte.astro';
import SelloHechoAMano from './ui/SelloHechoAMano.astro';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import hero from '../data/hero.json';
import site from '../data/site.json';
import { photo } from '../lib/photos';
import { waLink } from '../lib/whatsapp';

const lines = hero.titleLines;
const trust = site.city ? [`Taller en ${site.city}`, ...hero.trust] : hero.trust;
---

<section id="inicio" class="hero relative bg-crema pb-14 lg:pb-20" aria-labelledby="hero-titulo">
  <div class="container-x sm:pt-4 lg:pt-5">
    <div class="hero-banner relative -mx-5 sm:mx-0">
      <div class="hero-photo overflow-hidden bg-champana-200 sm:rounded-card">
        <Image
          src={photo(hero.image)}
          alt={hero.imageAlt}
          widths={[390, 600, 780, 1000, 1170]}
          sizes="(min-width: 1320px) 1224px, (min-width: 1024px) calc(100vw - 96px), (min-width: 640px) calc(100vw - 64px), 100vw"
          quality={76}
          loading="eager"
          fetchpriority="high"
          class="hero-img block h-auto w-full"
          data-crop-ok
        />
      </div>
      <SelloHechoAMano class="hero-sello absolute bottom-0 right-5 w-[5.25rem] translate-y-1/2 sm:right-8 sm:w-[6.5rem] lg:right-12 lg:w-[6.75rem] xl:w-[8rem]" />
    </div>

    <div class="hero-copy mt-9 grid grid-cols-[minmax(0,1fr)] gap-6 sm:mt-12 lg:mt-[3.75rem] lg:grid-cols-12 xl:mt-[4.5rem] lg:items-start lg:gap-12">
      <h1 id="hero-titulo" class="hero-title text-display text-negro lg:col-span-6 xl:col-span-7">
        {lines.map((l, i) => (
          <><span class:list={['block lg:inline', i === hero.emphasis && 'italic text-esmeralda']}>{l}</span>{i < lines.length - 1 && ' '}</>
        ))}
      </h1>

      <div class="lg:col-span-6 lg:pt-2 xl:col-span-5">
        <p class="max-w-[34rem] text-lead text-gris">
          {hero.subtitle}{hero.subtitleMore && <span class="hidden sm:inline"> {hero.subtitleMore}</span>}
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-7">
          <a href={waLink(hero.ctaMessage)} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
            <Icon name="whatsapp" size={20} />
            {hero.ctaPrimary}
          </a>
          <a href={hero.ctaSecondaryHref} class="link-arrow justify-center text-negro sm:justify-start">
            <span class="link-line">{hero.ctaSecondary}</span>
            <Icon name="arrow" size={16} class="btn-arrow" />
          </a>
        </div>
        <div class="mt-9 max-w-[34rem]">
          <Pespunte class="text-sepia" />
          <div class="mt-4 overflow-hidden">
            <ul class="hero-trust grid gap-1.5 text-small text-gris sm:flex sm:flex-wrap">
              {trust.map((t) => <li>{t}</li>)}
            </ul>
          </div>
          {!site.city && <Todo text="ciudad y zona de cobertura para la línea de confianza" class="mt-3" />}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Móvil: la foto completa, en su proporción natural. Desde 640px, proporción fija de banner; en escritorio,
    además, un alto máximo según la pantalla para que el botón de cotizar quede dentro del primer pantallazo.
  */
  @media (min-width: 640px) {
    .hero-photo {
      aspect-ratio: 1.9;
    }
    .hero-photo :global(.hero-img) {
      height: 100%;
      object-fit: cover;
      object-position: 50% 80%;
    }
  }
  @media (min-width: 1024px) {
    .hero-photo {
      aspect-ratio: 2.6;
      min-height: 16rem;
      max-height: calc(100svh - 28rem);
      width: 100%;
    }
  }
  /* Titular: 4 renglones cortos en móvil; en escritorio corre en 2–3 renglones equilibrados. */
  .hero-title {
    font-size: clamp(2.15rem, 1.6rem + 3.4vw, 3.9rem);
  }
  @media (min-width: 1024px) {
    .hero-title {
      text-wrap: balance;
    }
  }
  /* En fila: un punto sepia entre datos. El contenedor recorta el punto del primer dato de cada renglón. */
  @media (min-width: 640px) {
    .hero-trust {
      margin-left: -1.6rem;
    }
    .hero-trust li {
      position: relative;
      margin-left: 1.6rem;
    }
    .hero-trust li::before {
      content: '';
      position: absolute;
      left: -0.95rem;
      top: 50%;
      width: 4px;
      height: 4px;
      margin-top: -2px;
      border-radius: 50%;
      background: var(--color-sepia);
    }
  }
  /*
    Un solo momento de entrada. La foto y el titular nunca están invisibles (son el LCP): la foto se asienta
    con un movimiento corto, el texto sube 10px y el sello aparece después.
  */
  .hero-photo :global(.hero-img) {
    animation: hero-settle 1200ms var(--ease-salida) both;
  }
  .hero-copy {
    animation: hero-rise 900ms var(--ease-salida) both;
  }
  /* El sello es otro componente: se alcanza con :global. */
  :global(.hero-sello) {
    animation: fade-up 900ms var(--ease-salida) 350ms both;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo :global(.hero-img),
    .hero-copy {
      animation: none;
    }
    :global(.hero-sello) {
      animation: fade-only 200ms linear both;
    }
  }
  @keyframes hero-settle {
    from {
      transform: scale(1.025);
    }
    to {
      transform: none;
    }
  }
  @keyframes hero-rise {
    from {
      transform: translateY(10px);
    }
    to {
      transform: none;
    }
  }
</style>
