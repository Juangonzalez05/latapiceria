---
// Sello «Hecho a mano · Comodidad hecha diseño»: texto circular alrededor de la silla del logo.
// Decorativo (el mensaje ya está en el texto de la página), estático y en la paleta: anillo sepia,
// silla del logo a color y texto terra.
import { SILLA_VIEWBOX, sillaInner } from '../../lib/silla.mjs';

interface Props {
  class?: string;
  text?: string;
}
const { class: cls = '', text = 'Hecho a mano · Comodidad hecha diseño · ' } = Astro.props;
const id = `sello-${Math.random().toString(36).slice(2, 8)}`;
---

<svg class:list={['sello', cls]} viewBox="0 0 140 140" aria-hidden="true" focusable="false">
  <defs>
    <path id={id} d="M70,70 m-52,0 a52,52 0 1,1 104,0 a52,52 0 1,1 -104,0" />
  </defs>
  <circle cx="70" cy="70" r="68" fill="var(--color-crema-50)" />
  <circle cx="70" cy="70" r="66" fill="none" stroke="var(--color-sepia)" stroke-width="1" />
  <circle cx="70" cy="70" r="38" fill="none" stroke="var(--color-sepia)" stroke-width="0.8" stroke-dasharray="3 3" />
  <text class="sello-texto" fill="var(--color-terra-700)">
    <textPath href={`#${id}`} textLength="324" lengthAdjust="spacing">{text.toUpperCase()}</textPath>
  </text>
  <!-- Silla del logo a color, centrada -->
  <svg x="53" y="44" width="34" height="50" viewBox={SILLA_VIEWBOX} set:html={sillaInner({ id: `${id}-silla`, ink: 'var(--color-terra-700)', fill: 'var(--color-terra)', shade: 'var(--color-terra-700)', stroke: 9 })} />
</svg>

<style>
  .sello {
    display: block;
    filter: drop-shadow(0 10px 18px rgb(6 6 6 / 0.18));
  }
  .sello-texto {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }
</style>
