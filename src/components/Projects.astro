---
// Proyectos. Escritorio: grilla editorial de tamaños mixtos (máx. ~496px CSS por foto, nítida en 2x).
// Móvil: carrusel deslizable. Filtros solo para categorías con fotos reales.
import { Image, getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Todo from './Todo.astro';
import Lightbox from './Lightbox.astro';
import SectionHeader from './ui/SectionHeader.astro';
import data from '../data/projects.json';
import { photo } from '../lib/photos';

const items = await Promise.all(
  data.items.map(async (p) => {
    const full = await getImage({ src: photo(p.image), width: 1100, format: 'webp', quality: 82 });
    return { ...p, full: full.src };
  })
);
const label = (id: string) => data.categories.find((c) => c.id === id)?.label ?? id;
// «Todos» siempre; el resto solo si tiene al menos un proyecto.
const categories = data.categories.filter((c) => c.id === 'todos' || items.some((i) => i.category === c.id));
const missing = data.categories.filter((c) => c.id !== 'todos' && !items.some((i) => i.category === c.id));
---

<section id="proyectos" class="section-y overflow-hidden bg-crema" aria-labelledby="proyectos-titulo" data-projects>
  <div class="container-x">
    <SectionHeader id="proyectos-titulo" title="Piezas que ya tienen hogar">
      <div class="no-scrollbar -mx-5 flex gap-2 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:justify-end md:px-0" role="group" aria-label="Filtrar proyectos por categoría">
        {categories.map((c, i) => (
          <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c.id}>{c.label}</button>
        ))}
      </div>
      {missing.length > 0 && <Todo text={`agregar fotos de: ${missing.map((m) => m.label).join(', ')}`} class="mt-3" />}
    </SectionHeader>

    <ul class="projects no-scrollbar -mx-5 flex snap-x snap-mandatory gap-4 overflow-x-auto px-5 pb-2 lg:mx-0 lg:grid lg:snap-none lg:grid-cols-12 lg:gap-x-6 lg:gap-y-12 lg:overflow-visible lg:px-0 lg:pb-0" data-track aria-label="Proyectos">
      {items.map((p, i) => (
        <li class="project w-[78%] shrink-0 snap-start sm:w-[46%] lg:w-auto" data-category={p.category} data-slot={i % 6}>
          <button
            type="button"
            class="group block w-full text-left"
            data-open-lightbox
            data-full={p.full}
            data-alt={p.alt}
            data-title={p.title}
            data-cat={label(p.category)}
            aria-label={`Ampliar: ${p.title}`}
          >
            <span class="frame project-frame block">
              <Image
                src={photo(p.image)}
                alt={p.alt}
                widths={[300, 400, 500, 800, 1000]}
                sizes="(min-width: 1024px) 34vw, (min-width: 640px) 46vw, 78vw"
                class="h-full w-full object-cover transition-transform duration-[900ms] ease-[var(--ease-salida)] group-hover:scale-[1.03]"
                data-motion="transform"
              />
              <span class="absolute right-3 top-3 grid size-10 place-items-center rounded-full bg-crema/90 text-negro opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
                <Icon name="expand" size={16} />
              </span>
            </span>
            <span class="mt-3 flex flex-col gap-1 lg:flex-row lg:items-baseline lg:justify-between lg:gap-4">
              <span class="font-serif text-[1.15rem] text-negro">{p.title}</span>
              <span class="label shrink-0">{label(p.category)}</span>
            </span>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex items-center justify-between gap-4 lg:hidden">
      <p class="text-small text-gris" aria-live="polite" data-count></p>
      <div class="flex gap-2">
        <button type="button" class="carousel-arrow" aria-label="Proyecto anterior" data-prev><Icon name="arrow-left" /></button>
        <button type="button" class="carousel-arrow" aria-label="Proyecto siguiente" data-next><Icon name="arrow" /></button>
      </div>
    </div>
    <div class="mt-12 hidden items-center justify-between gap-6 border-t border-negro/10 pt-6 lg:flex">
      <p class="text-small text-gris" aria-live="polite" data-count-desktop></p>
      <button type="button" class="link-arrow text-negro" aria-expanded="false" data-more hidden>
        <span class="link-line" data-more-label>Ver todos los proyectos</span>
        <Icon name="arrow" size={16} class="btn-arrow rotate-90" />
      </button>
    </div>
  </div>

  <Lightbox />
</section>

<style>
  .project[hidden] {
    display: none;
  }
  .project-frame {
    aspect-ratio: 4 / 5;
  }
  /*
    Escritorio: dos filas espejo que se repiten (5-4-3 / 3-4-5 columnas de 12),
    con desfases verticales suaves. data-slot se recalcula al filtrar.
  */
  @media (min-width: 1024px) {
    .project[data-slot='0'] {
      grid-column: span 5;
    }
    .project[data-slot='1'] {
      grid-column: span 4;
      margin-top: 3rem;
    }
    .project[data-slot='2'] {
      grid-column: span 3;
    }
    .project[data-slot='2'] .project-frame {
      aspect-ratio: 3 / 4;
    }
    .project[data-slot='3'] {
      grid-column: span 3;
      margin-top: 1.5rem;
    }
    .project[data-slot='3'] .project-frame {
      aspect-ratio: 3 / 4;
    }
    .project[data-slot='4'] {
      grid-column: span 4;
    }
    .project[data-slot='5'] {
      grid-column: span 5;
      margin-top: 2.5rem;
    }
    .project[data-slot='0'] .project-frame,
    .project[data-slot='5'] .project-frame {
      aspect-ratio: 1 / 1;
    }
  }
  /* Escritorio: se muestran 9 y el resto con «Ver todos» (el carrusel móvil los muestra todos). */
  @media (min-width: 1024px) {
    .projects:not(.is-expanded) .project.is-extra {
      display: none;
    }
  }
  .project.is-entering {
    animation: fade-up 450ms var(--ease-salida) both;
  }
  @media (prefers-reduced-motion: reduce) {
    .project.is-entering {
      animation: fade-only 150ms linear both;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-projects]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const items = [...track.querySelectorAll<HTMLElement>('.project')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const counts = root.querySelectorAll<HTMLElement>('[data-count], [data-count-desktop]');
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const more = root.querySelector<HTMLButtonElement>('[data-more]')!;
    const moreLabel = root.querySelector<HTMLElement>('[data-more-label]')!;
    const LIMIT = 9;
    more.addEventListener('click', () => {
      track.classList.add('is-expanded');
      more.hidden = true;
      more.setAttribute('aria-expanded', 'true');
      track.querySelector<HTMLElement>('.project.is-extra button')?.focus();
    });

    const visible = () => items.filter((i) => !i.hidden);
    const step = () => {
      const first = visible()[0];
      return first ? first.getBoundingClientRect().width + 16 : 300;
    };
    const updateArrows = () => {
      prev.setAttribute('aria-disabled', String(track.scrollLeft <= 4));
      next.setAttribute('aria-disabled', String(track.scrollLeft + track.clientWidth >= track.scrollWidth - 4));
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));
    track.addEventListener('scroll', () => requestAnimationFrame(updateArrows), { passive: true });
    window.addEventListener('resize', updateArrows);

    const apply = (cat: string, animate: boolean) => {
      let n = 0;
      for (const it of items) {
        const show = cat === 'todos' || it.dataset.category === cat;
        it.hidden = !show;
        if (!show) continue;
        it.dataset.slot = String(n % 6);
        it.classList.toggle('is-extra', n >= LIMIT);
        if (animate) {
          it.classList.remove('is-entering');
          void it.offsetWidth;
          it.classList.add('is-entering');
        }
        n++;
      }
      counts.forEach((c) => (c.textContent = `${n} ${n === 1 ? 'proyecto' : 'proyectos'}`));
      const expanded = track.classList.contains('is-expanded');
      more.hidden = expanded || n <= LIMIT;
      moreLabel.textContent = `Ver los ${n} proyectos`;
      track.scrollTo({ left: 0, behavior: 'instant' as ScrollBehavior });
      updateArrows();
    };
    filters.forEach((f) =>
      f.addEventListener('click', () => {
        filters.forEach((o) => o.setAttribute('aria-pressed', String(o === f)));
        apply(f.dataset.filter!, true);
      })
    );
    apply('todos', false);
  }
</script>
