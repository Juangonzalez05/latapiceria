---
// Trabajos en tela · «Confort que se siente» (título de la colección del catálogo del cliente).
// Galería de todo lo que el taller hace en tela, con filtros por tipo de pieza y «Ver más».
// Masonry con columnas CSS: cada foto va completa, en su proporción (nada se recorta, sin huecos).
// 2 columnas en móvil y 3 en escritorio (≤ ~384px CSS por foto, nítida en 2x).
// Las piezas en cuero están en su sección exclusiva (Leather.astro).
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import Foto from './ui/Foto.astro';
import SectionHeader from './ui/SectionHeader.astro';
import data from '../data/projects.json';
import { photo } from '../lib/photos';

const label = (id: string) => data.categories.find((c) => c.id === id)?.label ?? '';
const categories = data.categories.filter((c) => c.id === 'todos' || data.items.some((i) => i.category === c.id));
const items = await Promise.all(
  data.items.map(async (p) => {
    const src = photo(p.image);
    const full = await getImage({ src, width: Math.min(1100, src.width), format: 'webp', quality: 82 });
    return { ...p, full: full.src };
  })
);
---

<section id="trabajos" class="section-y bg-crema" aria-labelledby="trabajos-titulo" data-works data-limit={data.limit}>
  <div class="container-x">
    <SectionHeader id="trabajos-titulo" title={data.title} lead={data.lead}>
      <a href="#cuero" class="link-arrow mt-4 text-esmeralda">
        <span class="link-line">Ver las piezas en cuero</span>
        <Icon name="arrow" size={16} class="btn-arrow" />
      </a>
    </SectionHeader>

    <div class="no-scrollbar -mx-5 mb-8 flex gap-2 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:px-0" role="group" aria-label="Filtrar trabajos por tipo de pieza">
      {categories.map((c, i) => (
        <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-filter={c.id}>{c.label}</button>
      ))}
    </div>

    <ul class="works columns-2 gap-4 sm:gap-5 lg:columns-3 lg:gap-6" aria-label="Trabajos en tela" data-works-list>
      {items.map((p, i) => (
        <li class="work mb-4 break-inside-avoid sm:mb-5 lg:mb-6" data-category={p.category} hidden={i >= data.limit}>
          <button
            type="button"
            class="group block w-full text-left"
            data-open-lightbox
            data-lb-group="trabajos"
            data-full={p.full}
            data-alt={p.alt}
            data-title={p.title}
            data-cat={`${label(p.category)} · ${p.note}`}
            aria-label={`Ampliar: ${p.title}`}
          >
            <span class="relative block">
              <Foto
                src={photo(p.image)}
                alt={p.alt}
                widths={[180, 240, 320, 384, 480, 640, 768]}
                sizes="(min-width: 1280px) 384px, (min-width: 1024px) 30vw, 46vw"
                imgClass="work-img"
              />
              <span class="absolute right-2.5 top-2.5 grid size-9 place-items-center rounded-full bg-crema/90 text-negro opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100" aria-hidden="true">
                <Icon name="expand" size={15} />
              </span>
            </span>
            <span class="mt-2.5 block font-serif text-[1.05rem] leading-snug text-negro sm:text-[1.15rem]">{p.title}</span>
            <span class="mt-0.5 block text-small text-gris">{p.note}</span>
          </button>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-t border-negro/10 pt-6 lg:mt-8">
      <p class="text-small text-gris" aria-live="polite" data-works-count></p>
      <button type="button" class="btn btn-light !border !border-negro/20" aria-expanded="false" data-works-more>
        <span data-works-more-label>Ver más trabajos</span>
        <Icon name="arrow" size={16} class="btn-arrow rotate-90" />
      </button>
    </div>
  </div>
</section>

<style>
  /* Sin zoom (recortaría los bordes de la foto): la foto se eleva con una sombra suave. */
  .work :global(.work-img) {
    transition: box-shadow 500ms var(--ease-salida);
  }
  @media (hover: hover) {
    .work:hover :global(.work-img) {
      box-shadow: 0 22px 40px -24px rgb(6 6 6 / 0.55);
    }
  }
  .work.is-entering {
    animation: fade-only 400ms var(--ease-suave) both;
  }
</style>

<script>
  // Filtros (aria-pressed) + «Ver más»: se muestran `limit` fotos de la categoría activa y el resto al pedirlo.
  // Lo oculto lleva [hidden]: no ocupa espacio en las columnas y el lightbox lo salta.
  const root = document.querySelector<HTMLElement>('[data-works]');
  if (root) {
    const limit = Number(root.dataset.limit) || 9;
    const items = [...root.querySelectorAll<HTMLElement>('.work')];
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const count = root.querySelector<HTMLElement>('[data-works-count]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-works-more]')!;
    const moreLabel = root.querySelector<HTMLElement>('[data-works-more-label]')!;
    let category = 'todos';
    let expanded = false;

    const apply = (animate: boolean) => {
      const matching = items.filter((it) => category === 'todos' || it.dataset.category === category);
      items.forEach((it) => (it.hidden = true));
      matching.forEach((it, n) => {
        it.hidden = !expanded && n >= limit;
        if (animate && !it.hidden) {
          it.classList.remove('is-entering');
          void it.offsetWidth;
          it.classList.add('is-entering');
        }
      });
      const shown = matching.filter((it) => !it.hidden).length;
      count.textContent = `Mostrando ${shown} de ${matching.length} trabajos`;
      more.hidden = expanded || matching.length <= limit;
      moreLabel.textContent = `Ver los ${matching.length} trabajos`;
      more.setAttribute('aria-expanded', String(expanded));
    };

    more.addEventListener('click', () => {
      const firstHidden = items.find((it) => it.hidden && (category === 'todos' || it.dataset.category === category));
      expanded = true;
      apply(true);
      firstHidden?.querySelector<HTMLElement>('button')?.focus();
    });
    filters.forEach((f) =>
      f.addEventListener('click', () => {
        filters.forEach((o) => o.setAttribute('aria-pressed', String(o === f)));
        category = f.dataset.filter!;
        expanded = false;
        apply(true);
      })
    );
    apply(false);
  }
</script>
